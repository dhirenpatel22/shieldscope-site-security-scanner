msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:113
msgid ""
"Enable the openssl extension in php.ini for full SSL certificate scanning."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:138
msgid "SSL certificate has expired"
msgstr ""

#. translators: 1: CN, 2: expiry date
#: includes/checks/class-shieldscope-check-ssl.php:141
#, php-format
msgid ""
"The certificate for %1$s expired on %2$s. Browsers display a full-page "
"warning and will not connect without a security bypass."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:145
msgid ""
"Renew the SSL certificate immediately via your hosting panel or Let's "
"Encrypt (certbot renew)."
msgstr ""

#. translators: %d: days until expiry
#: includes/checks/class-shieldscope-check-ssl.php:169
#, php-format
msgid "SSL certificate is valid (%d days remaining)"
msgstr ""

#. translators: 1: CN, 2: expiry date
#: includes/checks/class-shieldscope-check-ssl.php:174
#, php-format
msgid "Certificate CN: %1$s. Expires: %2$s."
msgstr ""

#. translators: %d: days until expiry
#: includes/checks/class-shieldscope-check-ssl.php:189
#, php-format
msgid "SSL certificate expires in %d days"
msgstr ""

#. translators: 1: CN, 2: expiry date
#: includes/checks/class-shieldscope-check-ssl.php:194
#, php-format
msgid ""
"The certificate for %1$s expires on %2$s. Visitors will see a browser "
"warning once it lapses."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:198
msgid ""
"Renew the certificate before it expires. Let's Encrypt certificates can be "
"renewed up to 30 days early without affecting the next cycle."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:224
msgid "SSL certificate is not trusted or does not match the hostname"
msgstr ""

#. translators: 1: hostname, 2: TLS error message
#: includes/checks/class-shieldscope-check-ssl.php:227
#, php-format
msgid ""
"A connection to %1$s with certificate verification turned on failed: %2$s. "
"Browsers show a security warning for this certificate (for example a self-"
"signed certificate, a missing intermediate certificate or a certificate "
"issued for another hostname)."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:231
msgid ""
"Install a certificate from a trusted certificate authority that covers this "
"hostname, including the full intermediate chain. Let's Encrypt certificates "
"are free and most hosting panels can issue them."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:317
msgid "TLS version check skipped — cURL not available"
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:318
msgid ""
"The cURL PHP extension is required to probe TLS version support. It is not "
"loaded on this server."
msgstr ""

#: includes/checks/class-shieldscope-check-ssl.php:319
msgid "Enable the cURL extension in php.ini for TLS version scanning."
msgstr ""

